# JUPYTER NOTEBOOKS
# =================================

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# =================================
# PROJECT SPECIFIC
# =================================

# QuantFin specific ignores
comprehensive_api_test.py
final_test.py
test_api.py

# Plotly generated files
*.html

