# QuantFin Repository - Comprehensive .gitignore

# =================================
# PYTHON / BACKEND
# =================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
backend/.env
backend/.venv
backend/env/
backend/venv/

# Machine Learning Models
backend/ml_models/
*.pkl
*.joblib
*.h5
*.model

# =================================
# NODE.JS / FRONTEND
# =================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependency directories
node_modules/
jspm_packages/

# Build outputs
dist/
dist-ssr/
.next
out
.nuxt
.cache/
public

# Environment files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
*.local

# =================================
# DEVELOPMENT TOOLS
# =================================

# IDE / Editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# =================================
# DATABASE & DATA
# =================================

# SQLite
*.sqlite
*.sqlite3
*.db

# API Keys and Secrets
secrets.json
config.json
api_keys.json
credentials.json

# Downloaded market data
data/
*.csv
historical_data/
market_data/

# =================================
# TESTING & COVERAGE
# =================================

# Coverage reports
coverage/
.nyc_output/
htmlcov/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Test outputs
test-results/
test-reports/
.pytest_cache/

